# Supabase — ใช้เก็บ lead จากหน้าคำนวณฟรี (ตาราง leads)
# ไม่ตั้งค่าไว้: โหมด dev จะบันทึกลงไฟล์ .leads.local.jsonl แทน, โหมด production จะตอบ 503
NEXT_PUBLIC_SUPABASE_URL=https://<project-id>.supabase.co

# publishable key (เดิมชื่อ anon) — เปิดเผยได้ ใช้คู่กับ JWT ของผู้ใช้เพื่อให้ RLS บังคับสิทธิ์
# Dashboard > Project Settings > API Keys > publishable (ขึ้นต้นด้วย sb_publishable_)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# คีย์ฝั่ง server เท่านั้น — RLS ของตาราง leads ไม่เปิด insert ให้ anon
# Dashboard > Project Settings > API Keys > "secret" (ขึ้นต้นด้วย sb_secret_ ยาวประมาณ 50+ ตัวอักษร)
# ถ้าโปรเจกต์ยังใช้คีย์รุ่นเดิม ให้ใช้ service_role JWT (ขึ้นต้นด้วย eyJ) แทนได้
SUPABASE_SERVICE_ROLE_KEY=

# บัญชีรับโอนสำหรับเติมเครดิต — แสดงบนหน้า /pro/credits
# ไม่ตั้งค่า: หน้าจะขึ้นว่ายังไม่เปิดรับชำระเงิน แทนที่จะโชว์ช่องว่าง
NEXT_PUBLIC_PAYEE_BANK=
NEXT_PUBLIC_PAYEE_ACCOUNT_NAME=
NEXT_PUBLIC_PAYEE_ACCOUNT_NUMBER=
NEXT_PUBLIC_PAYEE_PROMPTPAY=

# Cloudflare Turnstile — กัน bot ที่ฟอร์มขอรายงาน (/api/leads)
# ไม่ตั้งค่า: ข้ามการตรวจ ฟอร์มยังใช้งานได้ตามปกติ (มี log เตือนฝั่ง server)
# สร้างคีย์ฟรีที่ dash.cloudflare.com > Turnstile > Add site
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# LINE Messaging API — แจ้งเตือน lead และส่งลิงก์รายงาน
# หมายเหตุ: LINE ส่งไฟล์ PDF ไม่ได้ ระบบจึงส่งการ์ดพร้อมปุ่มลิงก์ไปหน้ารายงานแทน
# สร้าง Official Account + Messaging API channel ที่ developers.line.biz
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# ลิงก์เพิ่มเพื่อน OA เช่น https://line.me/R/ti/p/@yourid
NEXT_PUBLIC_LINE_ADD_FRIEND_URL=
# URL จริงของเว็บ ใช้ประกอบลิงก์ในข้อความ LINE (ต้องเป็น absolute)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# อีเมล — ช่องทางเดียวที่ส่งไฟล์ PDF ให้ลูกค้าได้ (LINE แนบไฟล์ไม่ได้)
# เลือกทางใดทางหนึ่ง ไม่ตั้งค่าเลย = ไม่ส่ง (มี log เตือน)
# 1) Resend — ง่ายสุด ต้องยืนยันโดเมนก่อนใช้ from เป็นโดเมนตัวเอง
RESEND_API_KEY=
# 2) SMTP — ใช้อีเมลธุรกิจที่มีอยู่แล้วได้ เช่น Google Workspace
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=PROINVENTIVE Solar <noreply@example.com>

# ที่อยู่ Chrome/Edge สำหรับสร้าง PDF — ปกติหาเจอเองบน Windows/Linux/macOS
# ตั้งค่าเมื่อเซิร์ฟเวอร์ติดตั้งเบราว์เซอร์ไว้ที่อื่น
CHROME_EXECUTABLE_PATH=

# รหัสลับสำหรับเรียกงานตามเวลา (/api/cron/*) — ไม่ตั้ง = endpoint ปิดตาย
# ตั้งตัวตั้งเวลาข้างนอกให้เรียกวันละครั้ง เช่น Vercel Cron หรือ cron-job.org
CRON_SECRET=
